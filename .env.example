# Copy to .env and fill in. Never commit .env.
# Ollaya daemon address (Ollaya's own variable; default 127.0.0.1:11435).
OLLAYA_HOST=127.0.0.1:11435
# Only if the daemon was started with OLLAYA_API_KEY.
OLLAYA_API_KEY=
OLLAYA_GATE_MODEL=winnow:e4b
# Optional: how long the daemon keeps the model loaded after a decision (e.g. 30m).
OLLAYA_GATE_KEEP_ALIVE=
OLLAYA_GATE_LOG=/absolute/path/to/decisions-plugin.jsonl
OLLAYA_GATE_DIR=/absolute/path/to/ollaya-decision-gate
OLLAYA_GATE_ENABLED=1
OLLAYA_GATE_TIMEOUT_MS=25000
